---
layout: null
permalink: /manifest.webmanifest
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "start_url": {{ '/?mode=standalone' | relative_url | jsonify }},
  "scope": {{ '/' | relative_url | jsonify }},
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "icons": [
    { "src": {{ '/assets/img/icon-192x192.png' | relative_url | jsonify }}, "sizes": "192x192", "type": "image/png" },
    { "src": {{ '/assets/img/icon-512x512.png' | relative_url | jsonify }}, "sizes": "512x512", "type": "image/png" }
  ]
}
